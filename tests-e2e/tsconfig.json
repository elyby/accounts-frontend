{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        // cypress ships its own types (not under @types/), and root doesn't declare an
        // explicit "types" array, so these need to be listed here to get `cy`/`Cypress`
        // globals without an explicit reference/import in every spec file.
        // "node" is for the Cypress config and the app's sources, reachable through the `app/...` type imports
        "types": ["cypress", "@testing-library/cypress", "node"],
        // fixtures are imported as `*.json`; root disables this because it conflicts with
        // `*.intl.json` overrides in the app, which doesn't apply to the test suite
        "resolveJsonModule": true
    },
    "include": ["../@types", "cypress/**/*", "cypress.config.ts"]
}
